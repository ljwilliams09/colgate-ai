{
  "manifest_version": 3,
  "name": "AI Chat Session Capture",
  "version": "1.0.0",
  "description": "Live capture of ChatGPT sends — turn mode, tools, latency, and model.",
  "permissions": ["storage", "sidePanel", "webRequest"],
  "host_permissions": [ 
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AI Session Capture"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["fetch-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
