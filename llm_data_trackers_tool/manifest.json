{
  "manifest_version": 3,
  "name": "Who's Watching?",
  "version": "1.0",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Who's Watching?"
  }
}